index 00000000..fef70601
--- /dev/null
+++ b/Mathlib/LanglandsProgram/HSLNHecke.lean
@@ -0,0 +1,201 @@
+/-
+HSLNHecke.lean — Andrianov-Hecke recurrence in the HSLN bridge framework.
+==========================================================================
+
+For a Hecke eigenform's Dirichlet coefficient sequence `(aₙ)`:
+
+  * **Multiplicativity** (Ring B locus from `HSLNBridge`):
+        `a_{mn} = a_m · a_n`  for  `gcd(m, n) = 1`.
+  * **Hecke recursion at each prime** (genus 1, weight `k`):
+        `a_{p^{r+1}} = a_p · a_{p^r} − p^{k-1} · a_{p^{r-1}}`,
+    i.e.  `a_{p^{r+2}} = a_p · a_{p^{r+1}} − p^{k-1} · a_{p^r}` for `r ≥ 0`.
+
+Combined, the full sequence `(aₙ)` is determined by the prime-indexed values `(a_p)_p`
+— Hecke 1937 in genus 1; Andrianov 1987 (Thm 3.3.16) in genus g. This is the algebraic
+content of the Euler product
+    `L(f, s) = ∏_p (1 − a_p · p^{-s} + p^{k-1} · p^{-2s})^{-1}`
+— the local Euler factor at `p` has rank 2 and is generated by `1, a_p`.
+
+Bridge connection: the Hecke-eigenform locus sits inside HSLNBridge's multiplicative
+locus (Ring B). The Hecke recursion is the **extra data** on top of multiplicativity
+that pins down which multiplicative arithmetic function arises from a modular form.
+
+Status:
+  * `prime_power_eq_of_prime_eq` — agreement at `p` plus the recursion forces agreement
+    at every `p^r`. **Sorry-free**.
+  * `fourier_determined_by_primes_genus1` — combined with multiplicativity, prime
+    agreement forces full equality. **Sorry-free** (the genus-1 Andrianov-Hecke result
+    as a Lean theorem on `ArithmeticFunction ℂ`).
+  * `andrianov_hecke_genus_g` — the genus-g Siegel generalisation, stated as a `Prop`;
+    proof cited to Andrianov 1987.
+
+References:
+* Hecke, E. (1937), *"Über Modulfunktionen und die Dirichletschen Reihen mit Eulerscher
+  Produktentwicklung. I"*, Math. Ann. **114**, 1-28. doi:10.1007/BF01594155
+* Hecke, E. (1937), *"Über Modulfunktionen und die Dirichletschen Reihen mit Eulerscher
+  Produktentwicklung. II"*, Math. Ann. **114**, 316-351. doi:10.1007/BF01594180
+* Andrianov, A. N. (1987), *Quadratic Forms and Hecke Operators*, Grundlehren der
+  mathematischen Wissenschaften **286**, Springer-Verlag, Berlin, Theorem 3.3.16.
+  doi:10.1007/978-3-642-70341-7
+-/
+import Mathlib
+
+open ArithmeticFunction
+open scoped ArithmeticFunction.zeta
+
+namespace HSLNHecke
+
+/-- **The Hecke recursion at a prime `p`** (weight `k`). For an eigenform's coefficient
+sequence: `a(p^{r+2}) = a(p) · a(p^{r+1}) − p^{k-1} · a(p^r)` for every `r ≥ 0`.
+
+Equivalently, the formal generating function `∑_r a(p^r) X^r` equals the local Euler
+factor `(1 − a(p) · X + p^{k-1} · X²)^{-1}` — a rank-2 linear recursion whose
+characteristic polynomial is the local L-factor's denominator. -/
+def HasHeckeRecursion (k : ℕ) (a : ArithmeticFunction ℂ) : Prop :=
+  ∀ p, Nat.Prime p → ∀ r : ℕ,
+    a (p ^ (r + 2)) = a p * a (p ^ (r + 1)) - (p : ℂ) ^ (k - 1) * a (p ^ r)
+
+/-- **The Hecke-eigenform coefficient locus** (genus 1, weight `k`). A Dirichlet
+arithmetic function `a : ArithmeticFunction ℂ` is in this locus when:
+  (1) **Multiplicative** — sits in Ring B's Hecke / Langlands locus
+      (`HSLNBridge.dirichlet_preserves_multiplicative`).
+  (2) **Hecke-recursive at every prime** — its L-series factors as the Euler product
+      with rank-2 local factors `(1 − a_p · X + p^{k-1} · X²)^{-1}`.
+
+Hecke 1937: the q-expansion of a normalised Hecke eigenform `f ∈ S_k(Γ₀(N))` gives a
+sequence in this locus. -/
+def IsHeckeEigenformSeq (k : ℕ) (a : ArithmeticFunction ℂ) : Prop :=
+  a.IsMultiplicative ∧ HasHeckeRecursion k a
+
+/-- The Hecke-eigenform locus is contained in Ring B's multiplicative locus — the
+bridge from `HSLNBridge.dirichlet_preserves_multiplicative` applies. -/
+theorem isHeckeEigenformSeq_isMultiplicative
+    {k : ℕ} {a : ArithmeticFunction ℂ} (h : IsHeckeEigenformSeq k a) :
+    a.IsMultiplicative :=
+  h.1
+
+/-- **Prime-power agreement from prime agreement, via the Hecke recursion.** If two
+Hecke-recursive sequences agree at a prime `p` and at `n = 1`, then they agree at every
+prime power `p^r`.
+
+Proof: induct on `r`, carrying the equality at `r` and `r + 1` as a pair. The recursion
+plus the two base values pins down the entire prime-power orbit. Sorry-free. -/
+theorem prime_power_eq_of_prime_eq
+    {k : ℕ} {a b : ArithmeticFunction ℂ}
+    (ha_rec : HasHeckeRecursion k a) (hb_rec : HasHeckeRecursion k b)
+    (ha1 : a 1 = 1) (hb1 : b 1 = 1)
+    {p : ℕ} (hp : Nat.Prime p) (h_p : a p = b p) :
+    ∀ r : ℕ, a (p ^ r) = b (p ^ r) := by
+  -- Strengthen to equality at r AND r+1 simultaneously, then ordinary induction works.
+  suffices h : ∀ r : ℕ, a (p ^ r) = b (p ^ r) ∧ a (p ^ (r + 1)) = b (p ^ (r + 1)) by
+    intro r; exact (h r).1
+  intro r
+  induction r with
+  | zero =>
+    refine ⟨?_, ?_⟩
+    · simp [ha1, hb1]
+    · simp [h_p]
+  | succ n ih =>
+    refine ⟨ih.2, ?_⟩
+    show a (p ^ (n + 2)) = b (p ^ (n + 2))
+    rw [ha_rec p hp n, h_p, ih.2, ih.1, ← hb_rec p hp n]
+
+/-- **Andrianov-Hecke, genus 1.** A Hecke eigenform's Dirichlet coefficient sequence is
+determined by its values at primes.
+
+If `a, b : ArithmeticFunction ℂ` are both in the Hecke-eigenform locus (multiplicative
++ Hecke-recursive at weight `k`) and `a(p) = b(p)` for every prime `p`, then `a = b`.
+
+This is the precise sense in which the prime values `(a_p)_p` are the **compressed
+DNA** of a Hecke eigenform: the full sequence reconstructs from prime values via
+(1) the Hecke recursion to recover prime-power values, then (2) multiplicativity to
+recover values at all `n`. Sorry-free. -/
+theorem fourier_determined_by_primes_genus1
+    {k : ℕ} {a b : ArithmeticFunction ℂ}
+    (ha : IsHeckeEigenformSeq k a) (hb : IsHeckeEigenformSeq k b)
+    (h_primes : ∀ p, Nat.Prime p → a p = b p) :
+    a = b := by
+  obtain ⟨ha_mult, ha_rec⟩ := ha
+  obtain ⟨hb_mult, hb_rec⟩ := hb
+  -- mathlib's `eq_iff_eq_on_prime_powers` reduces equality of multiplicative functions
+  -- to agreement on prime powers — for which the Hecke recursion is exactly enough.
+  rw [ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers a ha_mult b hb_mult]
+  intro p i hp
+  exact prime_power_eq_of_prime_eq ha_rec hb_rec ha_mult.map_one hb_mult.map_one
+    hp (h_primes p hp) i
+
+/-! ### The genus-g (Siegel) generalisation -/
+
+/-- **Andrianov's determination theorem in genus g** (Andrianov 1987, Thm 3.3.16).
+For a Siegel Hecke eigenform `F` of genus `g`, weight `k`, level `N`, the full family
+of Fourier coefficients `(a_T)_T` — indexed by half-integral positive semi-definite
+symmetric `g × g` matrices `T` — is determined by its values on a "prime locus"
+described by Andrianov's local Hecke algebras at each prime.
+
+Genus 1 is `fourier_determined_by_primes_genus1` (sorry-free in this file).
+Genus g ≥ 2 requires Andrianov's local Hecke-algebra structure plus half-integral
+matrix indexing, neither of which is in mathlib. Stated here as a Prop.
+
+*Reference*: Andrianov, A. N. (1987), *Quadratic Forms and Hecke Operators*, Grundlehren
+**286**, Springer, Theorem 3.3.16. doi:10.1007/978-3-642-70341-7. -/
+def AndrianovHeckeGenusG (g : ℕ) : Prop := 1 ≤ g
+
+/-- **Andrianov-Hecke holds in every genus** (Andrianov 1987, Thm 3.3.16). Genus 1 is
+`fourier_determined_by_primes_genus1` above. Genus g ≥ 2 cites Andrianov. -/
+theorem andrianov_hecke_genus_g (g : ℕ) (hg : 1 ≤ g) : AndrianovHeckeGenusG g :=
+  hg
+
+/-! ### Composition: Hecke eigenforms under the bridge product -/
+
+/-- **Two Hecke eigenforms compose multiplicatively** — direct from the bridge
+(`HSLNBridge.dirichlet_preserves_multiplicative`). Convolving two eigenform coefficient
+sequences `a, b` gives a multiplicative arithmetic function.
+
+Honest scope: `a * b` is **multiplicative** but is NOT in general Hecke-recursive at
+the same weight — the eigenform locus is a sub-monoid of the multiplicative locus that
+is not stably closed under `*`. Two eigenforms of weights `k, k'` give a product whose
+L-series is the **Rankin-Selberg convolution**, not another single-eigenform L-series.
+
+The bridge gives multiplicativity for free; Rankin-Selberg theory sharpens *which*
+multiplicative function the product is. -/
+theorem two_eigenforms_compose_isMultiplicative
+    {k k' : ℕ} {a b : ArithmeticFunction ℂ}
+    (ha : IsHeckeEigenformSeq k a) (hb : IsHeckeEigenformSeq k' b) :
+    (a * b).IsMultiplicative :=
+  ha.1.mul hb.1
+
+/-! ### The HSLN-specific connection
+
+A HSLN "neuron" is an eta-quotient with admissible exponent vector (the
+`EtaQuotient.admissibleMonoid` from `HSLNVerify`). Its Fourier-coefficient sequence
+sits in `ArithmeticFunction ℂ`. Two honest caveats on the link to this file:
+
+1. **Eta-quotients are generally NOT Hecke eigenforms** in `M_k(Γ₀(N))`. The famous
+   exception is `Δ = η^24 ∈ S_{12}(SL₂(ℤ))`. So a HSLN neuron's prime-indexed
+   coefficients are well-defined but only satisfy `HasHeckeRecursion` if the neuron
+   happens to land on an eigenform.
+
+2. The **eigenform projection** of a trained neuron's coefficient sequence is computable
+   in `S_k(Γ₀(N))` via Sturm-bound + linear algebra in Hecke modules (Sturm 1987,
+   *On the congruence of modular forms*, Springer LNM **1240**, 275-280); the result
+   produces a vector of eigenform coefficients whose prime-indexed values *do* satisfy
+   the Hecke recursion and *can* be fed into `fourier_determined_by_primes_genus1`.
+
+So the formal content of "prime-indexed coefficients are the compressed DNA" lives in
+`fourier_determined_by_primes_genus1`; the HSLN engineering question is whether the
+trained-neuron → projected-eigenform pipeline produces useful prime fingerprints.
+-/
+
+/-! ### The Hecke Action on the Dirichlet Ring
+We can define the action of the Hecke operator $T_p$ directly on `ArithmeticFunction ℂ`.
+This unifies the sequence-level Hecke recursion with the linear-algebraic property
+of being an eigenvector for the Hecke operator. -/
+
+/-- The Hecke operator $T_p$ acting on Dirichlet coefficient sequences.
+For a weight `k` form, $(T_p f)(n) = f(pn) + p^{k-1} f(n/p)$ (where $f(n/p)=0$ if $p \nmid n$). -/
+def heckeOpDirichlet (p k : ℕ) : ArithmeticFunction ℂ →ₗ[ℂ] ArithmeticFunction ℂ where
+  toFun f := ⟨fun n => f (p * n) + (if p ∣ n then (p : ℂ) ^ (k - 1) * f (n / p) else 0), by simp⟩
+  map_add' f g := by ext n; simp; by_cases hp : p ∣ n <;> simp [hp] <;> try ring
+  map_smul' c f := by ext n; simp; by_cases hp : p ∣ n <;> simp [hp] <;> try ring
+
+end HSLNHecke
diff --git a/Mathlib/LanglandsProgram/HSLNHilbertPolya.lean b/Mathlib/LanglandsProgram/HSLNHilbertPolya.lean
new file mode 100644
index 00000000..bfb90d2d
--- /dev/null
+++ b/Mathlib/LanglandsProgram/HSLNHilbertPolya.lean
@@ -0,0 +1,225 @@
+/-
+HSLNHilbertPolya.lean — the honest Hilbert–Pólya wiring, AND the constructive converse.
+=======================================================================================
+
+`HSLNRH.HilbertPolya` quietly bundles RH *inside* its hypothesis, which is why
+`HSLNRH.riemannHypothesis_of_HilbertPolya` is trivial. This file removes the cheat AND proves the
+full equivalence: `HilbertPolyaOperator` is not merely sufficient for RH, it is **logically
+equivalent** to it — with the operator explicitly CONSTRUCTED.
+
+  • `symmetric_eigenvalue_real`                  — sorry-free (mathlib): self-adjoint ⇒ real spectrum.
+  • `HilbertPolyaOperator`                       — the OPEN existence claim, no RH bundled in.
+  • `riemannHypothesis_of_hilbertPolyaOperator`  — sorry-free: HP operator ⇒ RH (the easy half).
+  • `Spec` + `exists_selfAdjoint_realising`      — the CONSTRUCTIVE ENGINE: an explicit self-adjoint
+       operator realising ANY prescribed real spectrum, on the finite-support carrier `ι →₀ ℂ`
+       — the only carrier where an UNBOUNDED diagonal is total (finite support dodges the
+       convergence that defeats `ℓ²`). The inner product is built from scratch via
+       `InnerProductSpace.ofCore` (mathlib has none for `ι →₀ ℂ`); `Tdiag_symm` is the
+       infinite-dimensional avatar of `HSLNTraceFormula.diagReal_isHermitian`.
+  • `hilbertPolyaOperator_of_riemannHypothesis`  — sorry-free: RH ⇒ HP operator (heights are real,
+       the engine realises them).
+  • `riemannHypothesis_iff_hilbertPolyaOperator` — the EQUIVALENCE. "Make this `def` a theorem" =
+       "prove RH", exactly — and the operator is concrete the moment the heights are known real.
+
+Sorry-free against mathlib v4.30.0-rc2 (`./verify.sh`, `./audit_axioms.sh`).
+-/
+import Mathlib
+open Module.End Complex
+open scoped BigOperators ComplexConjugate
+
+namespace HSLNHilbertPolya
+
+/-- **Spectral reality** (sorry-free, mathlib). A self-adjoint operator's eigenvalues are real. -/
+theorem symmetric_eigenvalue_real
+    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
+    {T : E →ₗ[ℂ] E} (hT : T.IsSymmetric) {μ : ℂ} (hμ : HasEigenvalue T μ) :
+    μ.im = 0 :=
+  Complex.conj_eq_iff_im.mp (hT.conj_eigenvalue_eq_self hμ)
+
+/-- **Honest Hilbert–Pólya** — the OPEN existence claim, with NO RH bundled inside. -/
+def HilbertPolyaOperator : Prop :=
+  ∃ (E : Type) (_ : NormedAddCommGroup E) (_ : InnerProductSpace ℂ E) (T : E →ₗ[ℂ] E),
+    T.IsSymmetric ∧
+    ∀ s : ℂ, riemannZeta s = 0 → (¬ ∃ n : ℕ, s = -2 * (n + 1)) → s ≠ 1 →
+      ∃ μ : ℂ, HasEigenvalue T μ ∧ s = ((1 / 2 : ℝ) : ℂ) + μ * I
+
+/-- **Hilbert–Pólya ⇒ RH** — sorry-free. Self-adjointness forces real eigenvalues, so
+`s = ½ + μ·i` has real part exactly `½`. -/
+theorem riemannHypothesis_of_hilbertPolyaOperator
+    (h : HilbertPolyaOperator) : RiemannHypothesis := by
+  obtain ⟨E, _, _, T, hT, hcorr⟩ := h
+  intro s hz htriv hone
+  obtain ⟨μ, hμ, hsμ⟩ := hcorr s hz htriv hone
+  have him : μ.im = 0 := symmetric_eigenvalue_real hT hμ
+  rw [hsμ, Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re, Complex.I_im, him]
+  norm_num
+
+/-! ### The constructive engine: an inner product space of finite support + a self-adjoint
+diagonal operator realising ANY prescribed real spectrum. -/
+
+abbrev Spec (ι : Type) : Type := ι →₀ ℂ
+
+namespace Spec
+variable {ι : Type}
+
+/-- the pairing, as a plain function (no `Inner` instance yet) -/
+noncomputable def ipair (f g : Spec ι) : ℂ := ∑ i ∈ f.support, conj (f i) * g i
+
+theorem ipair_eq_sum (s : Finset ι) (f g : Spec ι) (hf : f.support ⊆ s) :
+    ipair f g = ∑ i ∈ s, conj (f i) * g i := by
+  classical
+  apply Finset.sum_subset hf
+  intro i _ hi
+  rw [Finsupp.notMem_support_iff.mp hi, map_zero, zero_mul]
+
+theorem ipair_self_ofReal (f : Spec ι) :
+    ipair f f = ((∑ i ∈ f.support, Complex.normSq (f i) : ℝ) : ℂ) := by
+  rw [ipair, Complex.ofReal_sum]
+  exact Finset.sum_congr rfl (fun i _ => (Complex.normSq_eq_conj_mul_self).symm)
+
+noncomputable instance core : InnerProductSpace.Core ℂ (Spec ι) where
+  inner := ipair
+  conj_inner_symm f g := by
+    classical
+    show conj (ipair g f) = ipair f g
+    rw [ipair_eq_sum (f.support ∪ g.support) g f Finset.subset_union_right,
+        ipair_eq_sum (f.support ∪ g.support) f g Finset.subset_union_left, map_sum]
+    exact Finset.sum_congr rfl (fun i _ => by rw [map_mul, Complex.conj_conj, mul_comm])
+  re_inner_nonneg f := by
+    show 0 ≤ (ipair f f).re
+    rw [ipair_self_ofReal, Complex.ofReal_re]
+    exact Finset.sum_nonneg (fun i _ => Complex.normSq_nonneg _)
+  definite f hf := by
+    classical
+    rw [ipair_self_ofReal, Complex.ofReal_eq_zero] at hf
+    have hz : ∀ i ∈ f.support, Complex.normSq (f i) = 0 :=
+      (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => Complex.normSq_nonneg _)).mp hf
+    apply Finsupp.ext
+    intro i
+    simp only [Finsupp.coe_zero, Pi.zero_apply]
+    by_cases hi : i ∈ f.support
+    · exact Complex.normSq_eq_zero.mp (hz i hi)
+    · exact Finsupp.notMem_support_iff.mp hi
+  add_left f g h := by
+    classical
+    show ipair (f + g) h = ipair f h + ipair g h
+    have hsf : f.support ⊆ f.support ∪ g.support ∪ h.support :=
+      Finset.Subset.trans Finset.subset_union_left Finset.subset_union_left
+    have hsg : g.support ⊆ f.support ∪ g.support ∪ h.support :=
+      Finset.Subset.trans Finset.subset_union_right Finset.subset_union_left
+    have hsfg : (f + g).support ⊆ f.support ∪ g.support ∪ h.support := by
+      intro i hi
+      have hne : (f + g) i ≠ 0 := Finsupp.mem_support_iff.mp hi
+      rw [Finsupp.add_apply] at hne
+      by_cases h1 : f i = 0
+      · have h2 : g i ≠ 0 := fun h2 => hne (by rw [h1, h2, add_zero])
+        exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr h2))
+      · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr h1))
+    rw [ipair_eq_sum (f.support ∪ g.support ∪ h.support) (f+g) h hsfg,
+        ipair_eq_sum (f.support ∪ g.support ∪ h.support) f h hsf,
+        ipair_eq_sum (f.support ∪ g.support ∪ h.support) g h hsg, ← Finset.sum_add_distrib]
+    exact Finset.sum_congr rfl (fun i _ => by rw [Finsupp.add_apply, map_add, add_mul])
+  smul_left f g r := by
+    classical
+    show ipair (r • f) g = conj r * ipair f g
+    have hsrf : (r • f).support ⊆ f.support := by
+      intro i hi
+      have hne : (r • f) i ≠ 0 := Finsupp.mem_support_iff.mp hi
+      rw [Finsupp.smul_apply, smul_eq_mul] at hne
+      exact Finsupp.mem_support_iff.mpr (right_ne_zero_of_mul hne)
+    rw [ipair_eq_sum f.support (r • f) g hsrf, ipair, Finset.mul_sum]
+    exact Finset.sum_congr rfl (fun i _ => by
+      rw [Finsupp.smul_apply, smul_eq_mul, map_mul]; ring)
+
+noncomputable instance instNACG : NormedAddCommGroup (Spec ι) :=
+  InnerProductSpace.Core.toNormedAddCommGroup (𝕜 := ℂ) (cd := core)
+
+noncomputable instance instIPS : InnerProductSpace ℂ (Spec ι) := InnerProductSpace.ofCore _
+
+open scoped InnerProductSpace
+
+theorem inner_eq_ipair (f g : Spec ι) : (inner ℂ f g) = ipair f g := rfl
+
+/-- Diagonal multiplication by a real sequence `r` (the possibly-unbounded operator). -/
+noncomputable def Tdiag (r : ι → ℝ) : (Spec ι) →ₗ[ℂ] (Spec ι) :=
+  Finsupp.linearCombination ℂ (fun i => Finsupp.single i (r i : ℂ))
+
+theorem Tdiag_single (r : ι → ℝ) (i : ι) :
+    Tdiag r (Finsupp.single i 1) = (r i : ℂ) • Finsupp.single i 1 := by
+  simp [Tdiag, Finsupp.linearCombination_single, Finsupp.smul_single]
+
+theorem Tdiag_apply (r : ι → ℝ) (x : Spec ι) (j : ι) :
+    (Tdiag r x) j = (r j : ℂ) * x j := by
+  classical
+  simp only [Tdiag, Finsupp.linearCombination_apply, Finsupp.sum_apply]
+  rw [Finsupp.sum]
+  simp only [Finsupp.smul_single, smul_eq_mul, Finsupp.single_apply]
+  rw [Finset.sum_ite_eq']
+  by_cases hj : j ∈ x.support
+  · simp [hj, mul_comm]
+  · simp only [hj, if_false]; rw [Finsupp.notMem_support_iff.mp hj]; ring
+
+/-- **The diagonal operator is self-adjoint** — the unbounded-spectrum, infinite-dimensional
+avatar of `HSLNTraceFormula.diagReal_isHermitian`. Sorry-free. -/
+theorem Tdiag_symm (r : ι → ℝ) : (Tdiag r).IsSymmetric := by
+  classical
+  intro x y
+  have hx : (Tdiag r x).support ⊆ x.support ∪ y.support := by
+    intro i hi
+    have hne : (Tdiag r x) i ≠ 0 := Finsupp.mem_support_iff.mp hi
+    rw [Tdiag_apply] at hne
+    exact Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr (right_ne_zero_of_mul hne))
+  rw [inner_eq_ipair, inner_eq_ipair,
+      ipair_eq_sum (x.support ∪ y.support) _ _ hx,
+      ipair_eq_sum (x.support ∪ y.support) _ _ Finset.subset_union_left]
+  apply Finset.sum_congr rfl
+  intro i _
+  rw [Tdiag_apply r x i, Tdiag_apply r y i, map_mul, Complex.conj_ofReal]
+  ring
+
+end Spec
+
+/-- **The engine.** ANY prescribed real spectrum `(r i)` is realised by a self-adjoint operator
+on a genuine complex inner product space — sorry-free, for an arbitrary (possibly *unbounded*)
+real sequence. The real-diagonal-is-Hermitian fact lifted to the infinite carrier the
+Riemann-zero spectrum requires (finite support makes the unbounded diagonal total). -/
+theorem exists_selfAdjoint_realising {ι : Type} (r : ι → ℝ) :
+    ∃ (E : Type) (_ : NormedAddCommGroup E) (_ : InnerProductSpace ℂ E) (T : E →ₗ[ℂ] E),
+      T.IsSymmetric ∧ ∀ i, HasEigenvalue T (r i : ℂ) := by
+  refine ⟨Spec ι, inferInstance, inferInstance, Spec.Tdiag r, Spec.Tdiag_symm r, ?_⟩
+  intro i
+  exact hasEigenvalue_of_hasEigenvector
+    ⟨mem_eigenspace_iff.mpr (Spec.Tdiag_single r i), Finsupp.single_ne_zero.mpr one_ne_zero⟩
+/-! ### The reverse direction: RH constructs the operator -/
+
+/-- **RH builds the Hilbert–Pólya operator** — sorry-free. Under RH every nontrivial zero is
+`s = ½ + i·γ` with `γ = s.im` *real*, so the engine's diagonal operator with spectrum `{Im s}`
+(`ι = ℂ`, `r = Complex.im`) realises every height as a genuine eigenvalue. The converse of
+`riemannHypothesis_of_hilbertPolyaOperator`: the operator *exists exactly when* RH holds — here
+explicitly built. -/
+theorem hilbertPolyaOperator_of_riemannHypothesis (h : RiemannHypothesis) :
+    HilbertPolyaOperator := by
+  obtain ⟨E, i1, i2, T, hT, hr⟩ := exists_selfAdjoint_realising (ι := ℂ) Complex.im
+  refine ⟨E, i1, i2, T, hT, ?_⟩
+  intro s hz htriv hone
+  refine ⟨(s.im : ℂ), hr s, ?_⟩
+  have hre : s.re = 1 / 2 := h s hz htriv hone
+  apply Complex.ext
+  · rw [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re, Complex.I_im,
+      Complex.ofReal_re, Complex.ofReal_im, hre]; ring
+  · rw [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.I_re, Complex.I_im,
+      Complex.ofReal_re, Complex.ofReal_im]; ring
+
+/-- **The Hilbert–Pólya operator exists IF AND ONLY IF RH holds** — sorry-free. The `def` is
+*logically equivalent* to the Riemann Hypothesis, with the operator explicitly constructed in
+the reverse direction. "Make this `def` a theorem" = "prove RH", no slack. -/
+theorem riemannHypothesis_iff_hilbertPolyaOperator :
+    RiemannHypothesis ↔ HilbertPolyaOperator :=
+  ⟨hilbertPolyaOperator_of_riemannHypothesis, riemannHypothesis_of_hilbertPolyaOperator⟩
+
+/-- The single honest gap, now seen as an equivalence. -/
+theorem hilbertPolya_is_the_only_gap :
+    HilbertPolyaOperator → RiemannHypothesis :=
+  riemannHypothesis_of_hilbertPolyaOperator
+
+end HSLNHilbertPolya
