@@ -0,0 +1,111 @@
+/-
+HSLNDivisorEuler.lean — the divisor L-function as an Euler product: σ₃ ↔ ζ·ζ(·−3) ↔ E₄ ↔ E8.
+============================================================================================
+
+This is the Euler-product spine of the "divisor bridge" (figure 56): the link
+`DNA algebra → Eisenstein E₄ → E8 lattice → heterotic E8×E8`, grounded in a sorry-free
+arithmetic-function identity.
+
+The mathematical chain (each link a theorem):
+
+  σₖ = ζ * pow k        (Dirichlet ring: divisor-power function is ζ convolved with `n ↦ nᵏ`)
+       ↓ analytic shadow (Dirichlet series multiply)
+  ∑ σₖ(n) n⁻ˢ = ζ(s)·ζ(s−k)                          (Ramanujan)
+       ↓ Euler products multiply
+  ∏_p (1 − p⁻ˢ)⁻¹ (1 − p^{k−s})⁻¹                    (Euler product, Satake params {1, pᵏ})
+       ↓ at k = 3, the q-expansion of …
+  E₄(τ) = 1 + 240 ∑ σ₃(n) qⁿ = Θ_{E8}(τ)             (weight-4 level-1 is 1-dimensional)
+       ⇒ #{E8 vectors of norm 2n} = 240·σ₃(n).
+
+This file formalises the *arithmetic-function* core — the part that is fully proven and lives in
+the Dirichlet ring — and records the Euler-factor structure. The transcendental q-expansion /
+theta-series links (E₄ = Θ_{E8}, the `240`) are stated in prose as the bridge to geometry; the
+sorry-free content is the convolution identity `σₖ = ζ * pow k`, its multiplicativity (hence the
+existence of an Euler product), and the explicit local Euler factor at each prime.
+
+**The point for RH (per the Euler-product research):** the prime side of the Weil explicit
+formula is exactly the Euler product accessed through `−ζ'/ζ = ∑ Λ(n) n⁻ˢ`. The same Dirichlet
+multiplicativity that gives σₖ its Euler product is what gives ζ — and the divisor L-function
+`ζ(s)ζ(s−3)` is a *product of two ζ Euler products*, i.e. the E₄/Θ_{E8} L-function, with local
+factor `(1 − p⁻ˢ)⁻¹(1 − p^{3−s})⁻¹` and Satake parameters `{1, p³}`.
+
+`sorry`-free against mathlib v4.30.0-rc2 (`./verify.sh`, `./audit_axioms.sh`).
+-/
+import Mathlib
+
+open ArithmeticFunction Finset
+open scoped ArithmeticFunction.zeta
+
+namespace HSLNDivisorEuler
+
+/-! ### The divisor-power function as a Dirichlet convolution -/
+
+/-- **The divisor identity.** `σₖ = ζ * pow k` — the sum-of-`k`-th-powers-of-divisors function
+is the Dirichlet convolution of `ζ` (all ones) with `pow k : n ↦ nᵏ`. This is the coefficient-
+level identity whose Dirichlet-series shadow is `∑ σₖ(n) n⁻ˢ = ζ(s)·ζ(s−k)`. (mathlib's
+`zeta_mul_pow_eq_sigma`.) -/
+theorem sigma_eq_zeta_mul_pow (k : ℕ) :
+    (ζ : ArithmeticFunction ℕ) * ArithmeticFunction.pow k = ArithmeticFunction.sigma k :=
+  zeta_mul_pow_eq_sigma
+
+/-- **The divisor function is multiplicative — hence has an Euler product.** Both `ζ` and
+`pow k` are multiplicative, so their Dirichlet convolution `σₖ` is multiplicative; a
+multiplicative arithmetic function's Dirichlet series factors as an Euler product over primes.
+This is exactly the "two completely-multiplicative factors ⇒ Euler product" mechanism. -/
+theorem sigma_isMultiplicative (k : ℕ) : (ArithmeticFunction.sigma k).IsMultiplicative :=
+  isMultiplicative_sigma
+
+/-- `ζ` is multiplicative (the constant-1 generator / first Euler factor). -/
+theorem zeta_isMultiplicative : (ζ : ArithmeticFunction ℕ).IsMultiplicative :=
+  isMultiplicative_zeta
+
+/-- `pow k` is multiplicative (the `n ↦ nᵏ` generator / the shifted Euler factor `ζ(s−k)`). -/
+theorem pow_isMultiplicative (k : ℕ) : (ArithmeticFunction.pow k).IsMultiplicative :=
+  isMultiplicative_pow
+
+/-- **`σₖ` factors as the bridge product `ζ * pow k`, both multiplicative.** Reading the divisor
+identity through the Hecke/Langlands lens: `σₖ` lies in the multiplicative locus because it is a
+product of two locus elements (`ζ` and `pow k`) — the abelian-Langlands closure law again, here
+giving the divisor L-function `ζ(s)ζ(s−k)`. -/
+theorem sigma_mem_locus_via_factors (k : ℕ) :
+    (ArithmeticFunction.sigma k).IsMultiplicative ∧
+    (ζ : ArithmeticFunction ℕ) * ArithmeticFunction.pow k = ArithmeticFunction.sigma k :=
+  ⟨isMultiplicative_sigma, zeta_mul_pow_eq_sigma⟩
+
+/-! ### The local Euler factor at each prime -/
+
+/-- **The local Euler factor numerator.** At a prime `p`, `σₖ(pⁱ) = ∑_{j≤i} p^{jk}` — the
+truncated geometric series `1 + pᵏ + p²ᵏ + … + p^{ik}`. As `i → ∞` this is the generating
+function `(1 − p^{−s})⁻¹(1 − p^{k−s})⁻¹` expanded: the local Euler factor of `ζ(s)ζ(s−k)` has
+**Satake parameters `{1, pᵏ}`** (roots `α_p = 1`, `β_p = pᵏ`). -/
+theorem sigma_prime_pow (k : ℕ) {p i : ℕ} (hp : p.Prime) :
+    ArithmeticFunction.sigma k (p ^ i) = ∑ j ∈ Finset.range (i + 1), p ^ (j * k) :=
+  sigma_apply_prime_pow hp
+
+/-! ### The σ₃ specialisation: the E₄ / Θ_{E8} L-function -/
+
+/-- **σ₃ = ζ * pow 3** — the divisor-cube function, the Fourier DNA of the Eisenstein series
+`E₄ = 1 + 240 ∑ σ₃(n) qⁿ`. Its Dirichlet series is `ζ(s)·ζ(s−3)`; since `E₄ = Θ_{E8}` (the
+weight-4 level-1 space is 1-dimensional), `240·σ₃(n)` counts E8 lattice vectors of norm `2n`. -/
+theorem sigma3_eq_zeta_mul_pow3 :
+    (ζ : ArithmeticFunction ℕ) * ArithmeticFunction.pow 3 = ArithmeticFunction.sigma 3 :=
+  zeta_mul_pow_eq_sigma
+
+/-- **σ₃ at a prime power** — the local Euler factor of the E₄/Θ_{E8} L-function:
+`σ₃(pⁱ) = 1 + p³ + p⁶ + ⋯ + p^{3i}`, Satake parameters `{1, p³}`. -/
+theorem sigma3_prime_pow {p i : ℕ} (hp : p.Prime) :
+    ArithmeticFunction.sigma 3 (p ^ i) = ∑ j ∈ Finset.range (i + 1), p ^ (j * 3) :=
+  sigma_apply_prime_pow hp
+
+/-- **The divisor-Euler bridge, assembled** (sorry-free). σ₃ is `ζ * pow 3`, it is multiplicative
+(hence has an Euler product), and its local factor at every prime is the geometric series with
+Satake parameters `{1, p³}` — the L-function `ζ(s)ζ(s−3)` of the E₄ Eisenstein series and the
+E8 theta series. -/
+theorem divisor_euler_bridge :
+    ((ζ : ArithmeticFunction ℕ) * ArithmeticFunction.pow 3 = ArithmeticFunction.sigma 3) ∧
+    (ArithmeticFunction.sigma 3).IsMultiplicative ∧
+    (∀ {p i : ℕ}, p.Prime →
+      ArithmeticFunction.sigma 3 (p ^ i) = ∑ j ∈ Finset.range (i + 1), p ^ (j * 3)) :=
+  ⟨zeta_mul_pow_eq_sigma, isMultiplicative_sigma, fun hp => sigma_apply_prime_pow hp⟩
+
+end HSLNDivisorEuler
diff --git a/Mathlib/LanglandsProgram/HSLNFactor.lean b/Mathlib/LanglandsProgram/HSLNFactor.lean
new file mode 100644
index 00000000..7ffa4f42
--- /dev/null
+++ b/Mathlib/LanglandsProgram/HSLNFactor.lean
@@ -0,0 +1,155 @@
+/-
+The factoring conjecture, machine-checked.
+==========================================
+
+The HSLN conjecture (geometric form): take `N = p·q`, drive a "gravity DNA" to pull a
+marker onto `N`; the bent path through the lattice crosses exactly the points that are the
+prime factors, and the projection reveals them.
+
+E8 / the Coxeter plane is the *picture*. The *engine* is an arithmetic identity we already
+use elsewhere (the roots-of-unity sieve / inverse Euler product, `viz/prime_sieve.py`,
+commit "Primes by composition"). This file isolates that engine and proves the conjecture's
+honest, precise core SORRY-FREE against mathlib:
+
+  detector k N  :=  Σ_{j<k} ω^j      with ω = exp(2πi·N/k)
+
+  * `detector_eq`         : detector k N = k if k ∣ N, else 0   (geometric sum of roots of unity)
+  * `detector_fires`      : detector k N ≠ 0  ↔  k ∣ N          (the "projection lights up" at divisors)
+  * `factors_revealed`    : for a *prime* k, the projection of N = p·q fires ⇔ k = p ∨ k = q
+  * `primeFactors_mul_prime` / `two_points` : N = p·q has exactly the two prime factors {p,q}
+  * `primeFactors_three`  : N = p·q·r reveals {p,q,r}  — the "with 3 it would work" generalisation
+  * `semiprime_factors_revealed` : the capstone, all of the above bundled.
+
+Link to the Siegel/modular side: the divisor sum `σ` is the Fourier DNA of the weight-4
+Eisenstein series E₄ = Θ(E8) (see `HSLNBridge`/`HSLN`). `fires_iff_mem_divisors` shows the
+detector's support is exactly `N.divisors`, i.e. the support of that DNA. So the projection
+that "shows the factors" is reading the divisor structure carried by the modular form.
+
+Honest scope: this proves the factors are exactly the points the projection selects; it is
+NOT a sub-√N algorithm (the detector scans k up to the least factor). No RSA break is claimed.
+-/
+import Mathlib
+
+open Complex Real
+
+namespace HSLNFactor
+
+variable {k : ℕ}
+
+/-! ## §1 The roots-of-unity detector (the "projection") -/
+
+/-- The base `k`-th root carrying the phase of `N`: `ω = exp(2πi·N/k)`. -/
+noncomputable def zetaRoot (k N : ℕ) : ℂ :=
+  Complex.exp (2 * (π : ℂ) * I * (N : ℂ) / (k : ℂ))
+
+/-- The detector / projection: the geometric sum `Σ_{j<k} ω^j`. This is the inverse
+Euler-product probe — a sum of `k`-th roots of unity that resonates iff `k ∣ N`. -/
+noncomputable def detector (k N : ℕ) : ℂ :=
+  ∑ j ∈ Finset.range k, zetaRoot k N ^ j
+
+/-- `ω^k = 1`: the base really is a `k`-th root of unity. -/
+lemma zetaRoot_pow_self (hk : 0 < k) (N : ℕ) : zetaRoot k N ^ k = 1 := by
+  have hk' : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
+  unfold zetaRoot
+  rw [← Complex.exp_nat_mul]
+  have hcast : (k : ℂ) * (2 * (π : ℂ) * I * (N : ℂ) / (k : ℂ))
+      = (N : ℂ) * (2 * (π : ℂ) * I) := by
+    field_simp
+  rw [hcast, Complex.exp_nat_mul, Complex.exp_two_pi_mul_I, one_pow]
+
+/-- The resonance condition: `ω = 1` exactly when `k ∣ N`. -/
+lemma zetaRoot_eq_one_iff (hk : 0 < k) (N : ℕ) : zetaRoot k N = 1 ↔ k ∣ N := by
+  have hk' : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
+  have h2 : (2 * (π : ℂ) * I) ≠ 0 :=
+    mul_ne_zero (mul_ne_zero two_ne_zero (by exact_mod_cast Real.pi_ne_zero)) Complex.I_ne_zero
+  unfold zetaRoot
+  rw [Complex.exp_eq_one_iff]
+  constructor
+  · rintro ⟨n, hn⟩
+    rw [div_eq_iff hk'] at hn
+    have hNC : (N : ℂ) = (n : ℂ) * (k : ℂ) :=
+      mul_left_cancel₀ h2 (by linear_combination hn)
+    have hZ : (N : ℤ) = n * (k : ℤ) := by exact_mod_cast hNC
+    have hdvdZ : (k : ℤ) ∣ (N : ℤ) := ⟨n, by rw [hZ]; ring⟩
+    exact_mod_cast hdvdZ
+  · rintro ⟨m, rfl⟩
+    refine ⟨(m : ℤ), ?_⟩
+    push_cast
+    field_simp
+
+/-- **The detector identity.** `detector k N = k` if `k ∣ N`, and `0` otherwise.
+The exact "projection reveals divisors" statement. -/
+theorem detector_eq (hk : 0 < k) (N : ℕ) :
+    detector k N = if k ∣ N then (k : ℂ) else 0 := by
+  unfold detector
+  by_cases h : k ∣ N
+  · rw [if_pos h, (zetaRoot_eq_one_iff hk N).mpr h]
+    simp
+  · rw [if_neg h]
+    have hne : zetaRoot k N ≠ 1 := fun hc => h ((zetaRoot_eq_one_iff hk N).mp hc)
+    rw [geom_sum_eq hne k, zetaRoot_pow_self hk N]
+    simp
+
+/-- The projection "lights up" exactly at the divisors of `N`. -/
+theorem detector_fires (hk : 0 < k) (N : ℕ) : detector k N ≠ 0 ↔ k ∣ N := by
+  rw [detector_eq hk]
+  split_ifs with h
+  · rw [ne_eq, Nat.cast_eq_zero]; exact iff_of_true hk.ne' h
+  · exact iff_of_false (by simp) h
+
+/-- The detector's support is exactly the divisor set — the support of the modular
+divisor-DNA `σ` (E₄ = Θ(E8) Fourier coefficients). -/
+theorem fires_iff_mem_divisors (hk : 0 < k) {N : ℕ} (hN : 0 < N) :
+    detector k N ≠ 0 ↔ k ∈ N.divisors := by
+  rw [detector_fires hk, Nat.mem_divisors]
+  exact ⟨fun h => ⟨h, hN.ne'⟩, fun h => h.1⟩
+
+/-! ## §2 The factors are exactly what the projection selects -/
+
+/-- **The conjecture, prime form.** For `N = p·q` the projection fires on a prime `k`
+iff `k` is one of the two factors. (No false positives, no missed factors.) -/
+theorem factors_revealed {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
+    (hk : k.Prime) :
+    detector k (p * q) ≠ 0 ↔ k = p ∨ k = q := by
+  rw [detector_fires hk.pos, hk.dvd_mul,
+      Nat.prime_dvd_prime_iff_eq hk hp, Nat.prime_dvd_prime_iff_eq hk hq]
+
+/-- A semiprime's prime factors are exactly `{p, q}`. -/
+theorem primeFactors_mul_prime {p q : ℕ} (hp : p.Prime) (hq : q.Prime) :
+    (p * q).primeFactors = {p, q} := by
+  rw [Nat.primeFactors_mul hp.pos.ne' hq.pos.ne', hp.primeFactors, hq.primeFactors,
+      Finset.singleton_union]
+
+/-- "Exactly two points on the way to N": the count of prime factors of `p·q` is `2`
+(for distinct primes). -/
+theorem two_points {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
+    (p * q).primeFactors.card = 2 := by
+  rw [primeFactors_mul_prime hp hq, Finset.card_insert_of_notMem (by simp [hpq]),
+      Finset.card_singleton]
+
+/-- **"With 3 it would work."** A product of three primes reveals all three.
+(`{p,q,r}` as a set; equal to the three factors regardless of repetition, and of
+cardinality 3 when distinct.) -/
+theorem primeFactors_three {p q r : ℕ} (hp : p.Prime) (hq : q.Prime) (hr : r.Prime) :
+    (p * q * r).primeFactors = {p, q, r} := by
+  rw [Nat.primeFactors_mul (mul_pos hp.pos hq.pos).ne' hr.pos.ne',
+      primeFactors_mul_prime hp hq, hr.primeFactors]
+  ext x
+  simp [Finset.mem_insert]
+
+/-! ## §3 The capstone -/
+
+/-- **The factoring conjecture, precise and proved.**
+For a semiprime `N = p·q` with `p ≠ q` prime:
+1. the roots-of-unity projection fires on a prime `k` iff `k` is a factor;
+2. the prime factors are exactly `{p, q}`;
+3. there are exactly two of them.
+E8 / the Coxeter plane is the picture; this identity is the engine. -/
+theorem semiprime_factors_revealed {p q : ℕ}
+    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
+    (∀ k : ℕ, k.Prime → (detector k (p * q) ≠ 0 ↔ k = p ∨ k = q)) ∧
+      (p * q).primeFactors = {p, q} ∧
+      (p * q).primeFactors.card = 2 :=
+  ⟨fun _ hk => factors_revealed hp hq hk, primeFactors_mul_prime hp hq, two_points hp hq hpq⟩
+
+end HSLNFactor
diff --git a/Mathlib/LanglandsProgram/HSLNFrontier.lean b/Mathlib/LanglandsProgram/HSLNFrontier.lean
